<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/planner_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical"><TextView android:id="@+id/planner_prev" android:layout_width="30dp" android:layout_height="match_parent" android:text="‹" android:textSize="24sp" android:gravity="center" android:textColor="#aeb9c8" android:contentDescription="Vorige dag"/><TextView android:id="@+id/planner_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Vandaag" android:textSize="12sp" android:textStyle="bold" android:textColor="#aeb9c8" android:gravity="center"/><TextView android:id="@+id/planner_next" android:layout_width="30dp" android:layout_height="match_parent" android:text="›" android:textSize="24sp" android:gravity="center" android:textColor="#aeb9c8" android:contentDescription="Volgende dag"/><TextView android:id="@+id/planner_refresh" android:layout_width="32dp" android:layout_height="match_parent" android:text="↻" android:textSize="22sp" android:gravity="center" android:textColor="#4da4ff" android:contentDescription="Dagplanner verversen"/></LinearLayout>
<TextView android:id="@+id/focus_greeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="16dp" android:text="Goedemiddag, Thijs" android:textSize="25sp" android:textStyle="bold" android:textColor="#f5f7fb"/>
<LinearLayout android:id="@+id/focus_surface" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_input_background"><TextView android:id="@+id/focus_eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JOUW FOCUS" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16" android:textColor="#4da4ff"/><TextView android:id="@+id/focus_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="9dp" android:text="Een stap die nu past" android:textSize="22sp" android:textStyle="bold" android:textColor="#f5f7fb"/><TextView android:id="@+id/focus_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="9dp" android:text="Je dagplan wordt opgehaald." android:textSize="12sp" android:lineSpacingExtra="3dp" android:textColor="#aeb9c8"/><TextView android:id="@+id/focus_duration" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:textSize="12sp" android:textColor="#4da4ff"/><Chronometer android:id="@+id/planner_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="10dp" android:textSize="28sp" android:textColor="#4da4ff" android:visibility="gone"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="14dp"><TextView android:id="@+id/focus_primary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/widget_button" android:text="Start" android:gravity="center" android:textColor="#4da4ff" android:textSize="14sp" android:textStyle="bold"/><TextView android:id="@+id/focus_secondary" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingHorizontal="14dp" android:text="Nu even niet" android:gravity="center" android:textColor="#aeb9c8" android:textSize="12sp"/></LinearLayout>
</LinearLayout>
<TextView android:id="@+id/planner_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="10dp" android:textSize="11sp" android:textColor="#aeb9c8"/>
<TextView android:id="@+id/focus_next_heading" android:layout_width="match_parent" android:layout_height="28dp" android:text="DAARNA" android:letterSpacing="0.14" android:textSize="10sp" android:textStyle="bold" android:textColor="#aeb9c8"/><ListView android:id="@+id/focus_next_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="65dp" android:divider="@android:color/transparent" android:dividerHeight="6dp"/>
<TextView android:id="@+id/focus_habits_heading" android:layout_width="match_parent" android:layout_height="25dp" android:text="GEWOONTES" android:letterSpacing="0.14" android:textSize="10sp" android:textStyle="bold" android:textColor="#aeb9c8"/><ListView android:id="@+id/focus_habits" android:layout_width="match_parent" android:layout_height="72dp" android:divider="@android:color/transparent"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="10dp"><TextView android:id="@+id/focus_replan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Herplan" android:gravity="center" android:textSize="13sp" android:textColor="#4da4ff" android:background="@drawable/widget_input_background"/><TextView android:id="@+id/focus_checkin" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Check-in" android:gravity="center" android:textSize="13sp" android:textColor="#4da4ff"/></LinearLayout>
</LinearLayout>
