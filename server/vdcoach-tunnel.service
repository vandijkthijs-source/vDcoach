[Unit]
Description=vDcoach private OpenAI MCP tunnel
Requires=vdcoach.service
After=vdcoach.service
PartOf=vdcoach.service
ConditionPathExists=%h/Documents/ChatGPT/VdCoach/server/data/tunnel-key.cred

[Service]
Type=simple
WorkingDirectory=%h/Documents/ChatGPT/VdCoach
ExecStart=/usr/bin/python3 %h/Documents/ChatGPT/VdCoach/server/run_tunnel.py
LoadCredentialEncrypted=control-plane-api-key:%h/Documents/ChatGPT/VdCoach/server/data/tunnel-key.cred
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Documents/ChatGPT/VdCoach/server/data/tunnel

[Install]
WantedBy=default.target
