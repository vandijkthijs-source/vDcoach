[Unit]
Description=vDcoach private laptop server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/ChatGPT/VdCoach
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle:handle-lid-switch --who=vDcoach --why=Dedicated-server /usr/bin/python3 %h/Documents/ChatGPT/VdCoach/server/run_server.py
Environment=PYTHONUNBUFFERED=1
Environment=VDCOACH_PORT=2285
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Documents/ChatGPT/VdCoach/server/data
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
